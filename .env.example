# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database
# SQLite (Development)
DATABASE_URL=sqlite:///phola_park.db

# For Production, use PostgreSQL or MySQL
# DATABASE_URL=postgresql://username:password@localhost:5432/phola_park_app
# DATABASE_URL=mysql://username:password@localhost:3306/phola_park_app

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES=3600

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@pholapark.app

# File Upload Configuration
UPLOAD_FOLDER=phola_park_app/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif

# Application Settings
TESTING=False
LOG_LEVEL=INFO

# CORS Settings (if using API from different domain)
CORS_ORIGINS=*

# Security
REMEMBER_COOKIE_SECURE=False  # Set to True in production with HTTPS
REMEMBER_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=False   # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
